/// Ma Watchlist : nom de l'entreprise -> nombre d'actions détenues.
final ValueNotifier<Map<String, int>> maWatchlist = ValueNotifier<Map<String, int>>({});

void watchlistAjuster(String nom, int delta) {
  final Map<String, int> m = Map<String, int>.from(maWatchlist.value);
  final int q = (m[nom] ?? 0) + delta;
  if (q <= 0) {
    m.remove(nom);
  } else {
    m[nom] = q;
  }
  maWatchlist.value = m;
}

/// Statistiques réelles de la plateforme (fournies par le serveur / la feuille de cours).
/// Clés : investisseurs, reussite, investi. Tant qu'elles sont vides, l'application affiche "—".
final ValueNotifier<Map<String, num>> statsPlateforme = ValueNotifier<Map<String, num>>({});

class NimbaStatsBar extends StatelessWidget {
  const NimbaStatsBar({super.key});

  Widget _case(String valeur, String label, IconData icone) {
    return Expanded(
      child: Container(
        margin: const EdgeInsets.symmetric(horizontal: 4),
        padding: const EdgeInsets.symmetric(vertical: 12, horizontal: 6),
        decoration: BoxDecoration(color: Colors.white, borderRadius: BorderRadius.circular(14), border: Border.all(color: Colors.grey.shade200)),
        child: Column(
          children: [
            Icon(icone, size: 18, color: const Color(0xFF0D47A1)),
            const SizedBox(height: 4),
            Text(valeur, style: const TextStyle(fontSize: 15, fontWeight: FontWeight.bold, color: Color(0xFF0B1F3A))),
            const SizedBox(height: 2),
            Text(label, textAlign: TextAlign.center, style: const TextStyle(fontSize: 10, color: Colors.black54)),
          ],
        ),
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    return ValueListenableBuilder<Map<String, num>>(
      valueListenable: statsPlateforme,
      builder: (c, m, _) {
        final num? inv = m['investisseurs'];
        final num? rei = m['reussite'];
        final num? tot = m['investi'];
        String totTxt = '—';
        if (tot != null) totTxt = tot >= 1000000 ? '${(tot / 1000000).toStringAsFixed(1)}M GNF' : '${tot.toStringAsFixed(0)} GNF';
        return Column(
          children: [
            Row(
              children: [
                _case(inv == null ? '—' : inv.toInt().toString(), 'Investisseurs', Icons.groups_2_outlined),
                _case(rei == null ? '—' : '${rei.toStringAsFixed(0)} %', 'Taux de réussite', Icons.verified_outlined),
                _case(totTxt, 'Total investi', Icons.savings_outlined),
              ],
            ),
            const SizedBox(height: 4),
            Text(
              m.isEmpty ? 'Statistiques réelles disponibles dès le lancement' : 'Statistiques réelles de la plateforme',
              style: const TextStyle(fontSize: 9.5, color: Colors.black45),
            ),
          ],
        );
      },
    );
  }
}

/// Bandeau défilant en haut de l'application (style Binance).
class NimbaTickerBar extends StatefulWidget {
  final List<Map<String, dynamic>> entreprises;
  final Map<String, num> coursReels;
  const NimbaTickerBar({super.key, required this.entreprises, required this.coursReels});

  @override
  State<NimbaTickerBar> createState() => _NimbaTickerBarState();
}

class _NimbaTickerBarState extends State<NimbaTickerBar> {
  final ScrollController _ctrl = ScrollController();
  Timer? _t;

  @override
  void initState() {
    super.initState();
    _t = Timer.periodic(const Duration(milliseconds: 40), (_) {
      if (_ctrl.hasClients) _ctrl.jumpTo(_ctrl.offset + 1.2);
    });
  }

  @override
  void dispose() {
    _t?.cancel();
    _ctrl.dispose();
    super.dispose();
  }

  Widget _item(String label, String valeur, Color couleur, {Color? point}) {
    return Padding(
      padding: const EdgeInsets.symmetric(horizontal: 14),
      child: Row(
        children: [
          if (point != null) Container(width: 6, height: 6, margin: const EdgeInsets.only(right: 6), decoration: BoxDecoration(color: point, shape: BoxShape.circle)),
          Text(label, style: const TextStyle(color: Colors.white, fontSize: 11.5, fontWeight: FontWeight.bold)),
          const SizedBox(width: 6),
          Text(valeur, style: TextStyle(color: couleur, fontSize: 11.5, fontWeight: FontWeight.w600)),
        ],
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    final List<Widget> items = [];
    final num? fx = widget.coursReels['USD/GNF'];
    items.add(_item('USD/GNF', fx == null ? '—' : fx.toStringAsFixed(0), Colors.white70));
    for (final e in widget.entreprises) {
      final String sg = (e['sigle'] ?? e['nom'] ?? '').toString();
      final String hausse = (e['hausse'] ?? '').toString();
      final Color c = hausse.startsWith('-') ? const Color(0xFFFF5252) : const Color(0xFF00E676);
      final Color point = bourseOuverte(e['bourse']?.toString()) ? const Color(0xFF00E676) : const Color(0xFFFF5252);
      items.add(_item(sg, '${e['cours'] ?? '—'}  $hausse', c, point: point));
    }
    return Container(
      height: 34,
      color: const Color(0xFF0B1F3A),
      child: ListView.builder(
        controller: _ctrl,
        scrollDirection: Axis.horizontal,
        physics: const NeverScrollableScrollPhysics(),
        itemBuilder: (c, i) => Center(child: items[i % items.length]),
      ),
    );
  }
}

