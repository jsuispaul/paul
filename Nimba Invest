  void _startLiveTicker() {
    _liveTickerTimer = Timer.periodic(const Duration(seconds: 3), (timer) {
      if (!mounted) return;
      setState(() {
        isMarketOpen = bourses.any((b) => bourseOuverte(b[0]));
        for (var emp in entrepriseList) {
          num currentP = (emp['prix'] is num) ? emp['prix'] : 1000;
          double factor = 1.0 + ((num.parse((timer.tick % 5).toString()) - 2) * 0.001);
          final String sgl = (emp['sigle'] ?? '').toString();
          num newP = coursReels.containsKey(sgl) ? coursReels[sgl]! : (currentP * factor);
          emp['prix'] = newP;
          String dev = emp['devise'] ?? 'GNF';
          if (dev == 'USD') {
            emp['cours'] = '${newP.toStringAsFixed(2)} \$';
          } else if (dev == 'NGN') {
            emp['cours'] = '${newP.toStringAsFixed(2)} NGN';
          } else if (dev == 'CFA') {
            emp['cours'] = '${newP.toStringAsFixed(0)} CFA';
          } else {
            emp['cours'] = '${newP.toStringAsFixed(0)} GNF';
          }
        }
      });
    });
  }

