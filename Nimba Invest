class CoronthieFishermanPainter extends CustomPainter {
  @override
  void paint(Canvas canvas, Size size) {
    Rect rect = Rect.fromLTWH(0, 0, size.width, size.height);
    Gradient skyGradient = const LinearGradient(
      begin: Alignment.topCenter,
      end: Alignment.bottomCenter,
      colors: [
        Color(0xFF0D47A1), // Bleu Nuit
        Color(0xFF1565C0), // Bleu Océan Kaloum
        Color(0xFFE65100), // Orange Soleil Couchant
        Color(0xFFFFB300), // Doré Guinée
      ],
      stops: [0.0, 0.35, 0.70, 1.0],
    );
    Paint bgPaint = Paint()..shader = skyGradient.createShader(rect);
    canvas.drawRRect(RRect.fromRectAndRadius(rect, const Radius.circular(14)), bgPaint);

    // Soleil Couchant sur Conakry
    Paint sunPaint = Paint()..color = const Color(0xFFFFD54F).withOpacity(0.9);
    canvas.drawCircle(Offset(size.width * 0.80, size.height * 0.40), 28, sunPaint);

    // Vagues de l'Océan Atlantique (Coronthie)
    Path wavePath = Path();
    wavePath.moveTo(0, size.height * 0.58);
    wavePath.quadraticBezierTo(size.width * 0.25, size.height * 0.52, size.width * 0.50, size.height * 0.60);
    wavePath.quadraticBezierTo(size.width * 0.75, size.height * 0.68, size.width, size.height * 0.55);
    wavePath.lineTo(size.width, size.height);
    wavePath.lineTo(0, size.height);
    wavePath.close();

    Paint seaPaint = Paint()
      ..shader = LinearGradient(
        begin: Alignment.topCenter,
        end: Alignment.bottomCenter,
        colors: [const Color(0xFF0D47A1).withOpacity(0.90), const Color(0xFF002171)],
      ).createShader(rect);
    canvas.drawPath(wavePath, seaPaint);

    // Pirogue de Pêche Artisanale de Coronthie
    Path boatPath = Path();
    double bx = size.width * 0.18;
    double by = size.height * 0.66;
    boatPath.moveTo(bx, by);
    boatPath.quadraticBezierTo(bx + 40, by + 18, bx + 115, by);
    boatPath.lineTo(bx + 100, by - 6);
    boatPath.lineTo(bx + 15, by - 6);
    boatPath.close();

    Paint boatPaint = Paint()..color = const Color(0xFF111111);
    canvas.drawPath(boatPath, boatPaint);

    // Bandes Tricolores Nationales sur la Pirogue (Rouge, Jaune, Vert)
    Paint redL = Paint()..color = const Color(0xFFD32F2F)..strokeWidth = 2.5;
    Paint yellowL = Paint()..color = const Color(0xFFFBC02D)..strokeWidth = 2.5;
    Paint greenL = Paint()..color = const Color(0xFF388E3C)..strokeWidth = 2.5;

    canvas.drawLine(Offset(bx + 18, by - 2), Offset(bx + 95, by - 2), redL);
    canvas.drawLine(Offset(bx + 22, by + 2), Offset(bx + 90, by + 2), yellowL);
    canvas.drawLine(Offset(bx + 26, by + 6), Offset(bx + 85, by + 6), greenL);

    // Pêcheur de Coronthie debout
    Paint fishermanP = Paint()..color = const Color(0xFF111111)..strokeWidth = 3.0..style = PaintingStyle.stroke;
    canvas.drawCircle(Offset(bx + 45, by - 26), 4.5, Paint()..color = const Color(0xFF111111));
    canvas.drawLine(Offset(bx + 45, by - 22), Offset(bx + 45, by - 8), fishermanP);
    canvas.drawLine(Offset(bx + 45, by - 18), Offset(bx + 62, by - 24), fishermanP);
    canvas.drawLine(Offset(bx + 45, by - 18), Offset(bx + 30, by - 14), fishermanP);

    // Filet de Pêche Déployé sur l'Eau
    Path netPath = Path();
    netPath.moveTo(bx + 62, by - 24);
    netPath.lineTo(bx + 110, by - 12);
    netPath.lineTo(bx + 125, by + 12);
    netPath.lineTo(bx + 78, by + 10);
    netPath.close();

    Paint netP = Paint()
      ..color = const Color(0xFFFFD54F).withOpacity(0.45)
      ..style = PaintingStyle.stroke
      ..strokeWidth = 1.2;
    canvas.drawPath(netPath, netP);
  }

  @override
  bool shouldRepaint(covariant CustomPainter oldDelegate) => false;
}

