    if (isSignUp && phoneCtrl.text.replaceAll(RegExp(r'[^0-9]'), '').length < 8) return 'Entrez un numéro de téléphone valide.';
    if (isSignUp && villeCtrl.text.trim().isEmpty) return 'Entrez votre ville de résidence.';
    if (passCtrl.text.length < 8) return 'Le mot de passe doit contenir au moins 8 caractères.';
