final ValueNotifier<bool> modeAdmin = ValueNotifier<bool>(false);
// TEMPORAIRE : en production, remplacer par le rôle admin Firebase (claim "admin") : un code écrit dans l'application peut être lu par n'importe qui.
const String codeAdminLocal = 'NIMBA-ADMIN-2026';

void demanderCodeAdmin(BuildContext context) {
  if (modeAdmin.value) {
    modeAdmin.value = false;
    ScaffoldMessenger.of(context).showSnackBar(const SnackBar(content: Text('Mode administrateur désactivé.')));
    return;
  }
  final TextEditingController ctrl = TextEditingController();
  showDialog(
    context: context,
    builder: (dCtx) => AlertDialog(
      title: const Text('Espace administrateur'),
      content: TextField(controller: ctrl, obscureText: true, decoration: const InputDecoration(labelText: 'Code administrateur')),
      actions: [
        TextButton(onPressed: () => Navigator.pop(dCtx), child: const Text('Annuler')),
        TextButton(
          onPressed: () {
            final bool ok = ctrl.text.trim() == codeAdminLocal;
            Navigator.pop(dCtx);
            if (ok) modeAdmin.value = true;
            ScaffoldMessenger.of(context).showSnackBar(SnackBar(content: Text(ok ? 'Mode administrateur activé : vous pouvez publier.' : 'Code incorrect.')));
          },
          child: const Text('Valider'),
        ),
      ],
    ),
  );
}

