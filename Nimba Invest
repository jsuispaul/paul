class _AssistantAccueilSheet extends StatefulWidget {
  final VoidCallback? onTermine;
  const _AssistantAccueilSheet({this.onTermine});

  @override
  State<_AssistantAccueilSheet> createState() => _AssistantAccueilSheetState();
}

class _AssistantAccueilSheetState extends State<_AssistantAccueilSheet> {
  final PageController _pc = PageController();
  int _page = 0;

  void _fermer() {
    Navigator.pop(context);
    widget.onTermine?.call();
  }

  @override
  void dispose() {
    _pc.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    final bool derniere = _page == _etapesAssistant.length - 1;
    return SafeArea(
      child: SizedBox(
        height: 380,
        child: Column(
          children: [
            Expanded(
              child: PageView.builder(
                controller: _pc,
                itemCount: _etapesAssistant.length,
                onPageChanged: (i) => setState(() => _page = i),
                itemBuilder: (c, i) {
                  final e = _etapesAssistant[i];
                  return Padding(
                    padding: const EdgeInsets.fromLTRB(28, 28, 28, 8),
                    child: Column(
                      mainAxisAlignment: MainAxisAlignment.center,
                      children: [
                        CircleAvatar(radius: 34, backgroundColor: const Color(0xFFE3EAFB), child: Icon(e[0] as IconData, size: 34, color: const Color(0xFF0D47A1))),
                        const SizedBox(height: 18),
                        Text(e[1] as String, textAlign: TextAlign.center, style: const TextStyle(fontSize: 19, fontWeight: FontWeight.bold, color: Color(0xFF0B1F3A))),
                        const SizedBox(height: 10),
                        Text(e[2] as String, textAlign: TextAlign.center, style: const TextStyle(fontSize: 13, height: 1.5, color: Colors.black54)),
                      ],
                    ),
                  );
                },
              ),
            ),
            Row(
              mainAxisAlignment: MainAxisAlignment.center,
              children: [
                for (int i = 0; i < _etapesAssistant.length; i++)
                  Container(
                    width: i == _page ? 18 : 7,
                    height: 7,
                    margin: const EdgeInsets.symmetric(horizontal: 3),
                    decoration: BoxDecoration(color: i == _page ? const Color(0xFF0D47A1) : Colors.grey.shade300, borderRadius: BorderRadius.circular(4)),
                  ),
              ],
            ),
            Padding(
              padding: const EdgeInsets.fromLTRB(16, 10, 16, 14),
              child: Row(
                children: [
                  TextButton(onPressed: _fermer, child: const Text('Passer')),
                  const Spacer(),
                  ElevatedButton(
                    onPressed: () {
                      if (derniere) {
                        _fermer();
                      } else {
                        _pc.nextPage(duration: const Duration(milliseconds: 250), curve: Curves.easeOut);
                      }
                    },
                    style: ElevatedButton.styleFrom(backgroundColor: const Color(0xFF0D47A1), foregroundColor: Colors.white),
                    child: Text(derniere ? 'Commencer' : 'Suivant'),
                  ),
                ],
              ),
            ),
          ],
        ),
      ),
    );
  }
}

