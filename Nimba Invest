class SimulateurRendementWidget extends StatefulWidget {
  final Map<String, dynamic> item;
  const SimulateurRendementWidget({super.key, required this.item});

  @override
  State<SimulateurRendementWidget> createState() => _SimulateurRendementWidgetState();
}

class _SimulateurRendementWidgetState extends State<SimulateurRendementWidget> {
  double montantInvestissement = 500000;

  @override
  Widget build(BuildContext context) {
    int prixAction = (widget.item['prix'] is num) ? (widget.item['prix'] as num).round() : 15000;
    if (prixAction <= 0) prixAction = 15000;

    int dividendeParAction = 450;
    if (widget.item['dividende'] != null) {
      String divStr = widget.item['dividende'].toString();
      RegExp reg = RegExp(r'(\d[\d\s]*)');
      var match = reg.firstMatch(divStr);
      if (match != null) {
        String numOnly = match.group(1)!.replaceAll(' ', '');
        int? parsed = int.tryParse(numOnly);
        if (parsed != null && parsed > 0) {
          dividendeParAction = parsed;
        }
      }
    } else {
      dividendeParAction = (prixAction * 0.045).round();
    }

    int nbActions = (montantInvestissement / prixAction).floor();
    int totalDividendesAn = nbActions * dividendeParAction;
    double rendementPct = (dividendeParAction / prixAction) * 100;
    
    double haussePct = 10.0;
    if (widget.item['hausse'] != null) {
      String hStr = widget.item['hausse'].toString().replaceAll('+', '').replaceAll('%', '').trim();
      double? parsedH = double.tryParse(hStr);
      if (parsedH != null) haussePct = parsedH;
    }
    double gainCapital = (nbActions * prixAction) * (haussePct / 100.0);
    double valeurTotaleProjete = (nbActions * prixAction) + totalDividendesAn + gainCapital;

    return SingleChildScrollView(
      padding: const EdgeInsets.all(16),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          const Text('Simulateur de Rendement & Dividendes', style: TextStyle(fontSize: 16, fontWeight: FontWeight.bold, color: Color(0xFF0D47A1))),
