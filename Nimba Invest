class _DabaPainter extends CustomPainter {
  final List<PricePoint> points;
  _DabaPainter({required this.points});

  @override
  void paint(Canvas canvas, Size size) {
    if (points.isEmpty) return;
    double minP = points.map((p) => p.price).reduce((a, b) => a < b ? a : b);
    double maxP = points.map((p) => p.price).reduce((a, b) => a > b ? a : b);
    double range = (maxP - minP) == 0 ? 1 : (maxP - minP);

    List<Offset> offsets = [];
    double dx = size.width / (points.length - 1);
    for (int i = 0; i < points.length; i++) {
      double x = i * dx;
      double y = size.height - (((points[i].price - minP) / range) * (size.height - 20)) - 10;
      offsets.add(Offset(x, y));
    }

    Path path = Path()..moveTo(offsets.first.dx, offsets.first.dy);
    for (int i = 0; i < offsets.length - 1; i++) {
      path.cubicTo(
        (offsets[i].dx + offsets[i + 1].dx) / 2, offsets[i].dy,
        (offsets[i].dx + offsets[i + 1].dx) / 2, offsets[i + 1].dy,
        offsets[i + 1].dx, offsets[i + 1].dy,
      );
    }

    Path fillPath = Path.from(path)
      ..lineTo(size.width, size.height)
      ..lineTo(0, size.height)
      ..close();

    Paint fillPaint = Paint()
      ..shader = LinearGradient(
        begin: Alignment.topCenter,
        end: Alignment.bottomCenter,
        colors: [const Color(0xFF0F5132).withOpacity(0.18), Colors.transparent],
      ).createShader(Rect.fromLTWH(0, 0, size.width, size.height));

    canvas.drawPath(fillPath, fillPaint);

    Paint linePaint = Paint()
      ..color = const Color(0xFF0F5132)
      ..strokeWidth = 2.5
      ..style = PaintingStyle.stroke;

    canvas.drawPath(path, linePaint);
  }

  @override
  bool shouldRepaint(covariant CustomPainter oldDelegate) => true;
}

