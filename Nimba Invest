          padding: const EdgeInsets.symmetric(horizontal: 10, vertical: 4),
          decoration: BoxDecoration(color: Colors.green.shade100, borderRadius: BorderRadius.circular(12)),
          child: const Text('✅ VALIDÉ', style: TextStyle(color: Color(0xFF0F5132), fontWeight: FontWeight.bold, fontSize: 11)),
        );
      case KycStatus.enAttente:
        return Container(
          padding: const EdgeInsets.symmetric(horizontal: 10, vertical: 4),
          decoration: BoxDecoration(color: Colors.amber.shade100, borderRadius: BorderRadius.circular(12)),
          child: const Text('⏳ EN ATTENTE ADMIN', style: TextStyle(color: Color(0xFFB78103), fontWeight: FontWeight.bold, fontSize: 11)),
        );
      case KycStatus.rejete:
        return Container(
          padding: const EdgeInsets.symmetric(horizontal: 10, vertical: 4),
          decoration: BoxDecoration(color: Colors.red.shade100, borderRadius: BorderRadius.circular(12)),
          child: const Text('🔴 REJETÉ', style: TextStyle(color: Colors.red, fontWeight: FontWeight.bold, fontSize: 11)),
        );
      case KycStatus.nonSoumis:
      default:
        return Container(
          padding: const EdgeInsets.symmetric(horizontal: 10, vertical: 4),
          decoration: BoxDecoration(color: Colors.orange.shade100, borderRadius: BorderRadius.circular(12)),
          child: const Text('⚠️ NON SOUMIS', style: TextStyle(color: Colors.deepOrange, fontWeight: FontWeight.bold, fontSize: 11)),
        );
    }
  }

  String _getStatusDescription(KycStatus status) {
    switch (status) {
      case KycStatus.valide:
        return "Votre Certificat de Résidence a été vérifié et validé par l'Administrateur Nimba. Vous bénéficiez d'un accès complet pour effectuer vos opérations d'investissement.";
      case KycStatus.enAttente:
        return "Votre Certificat de Résidence est en cours de contrôle manuel par l'Administrateur Nimba. La navigation reste libre, mais les transactions sont temporairement réservées.";
      case KycStatus.rejete:
        return "Votre Certificat de Résidence n'a pas pu être validé (document expiré ou illisible). Veuillez re-téléverser un certificat conforme.";
      case KycStatus.nonSoumis:
      default:
        return "Vous n'avez pas encore fourni votre Certificat de Résidence. Remplissez le formulaire ci-dessous pour transmettre votre document à l'administrateur.";
    }
  }
