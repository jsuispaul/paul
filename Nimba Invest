void _ouvrirSelecteurCodePaysModal(BuildContext context, void Function(CountryPhoneCode) onSelect) {
  TextEditingController searchCtrl = TextEditingController();
  List<CountryPhoneCode> filteredList = List.from(allWorldCountryCodes);

  showModalBottomSheet(
    context: context,
    isScrollControlled: true,
    shape: const RoundedRectangleBorder(borderRadius: BorderRadius.vertical(top: Radius.circular(20))),
    builder: (sheetCtx) {
      return StatefulBuilder(
        builder: (BuildContext mCtx, StateSetter setModalState) {
          return Container(
            height: MediaQuery.of(context).size.height * 0.75,
            padding: const EdgeInsets.all(16),
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                Center(child: Container(width: 36, height: 4, decoration: BoxDecoration(color: Colors.grey.shade300, borderRadius: BorderRadius.circular(10)))),
                const SizedBox(height: 16),
                Row(
                  mainAxisAlignment: MainAxisAlignment.spaceBetween,
                  children: [
                    const Text('Sélectionner un Indicatif Pays', style: TextStyle(fontSize: 17, fontWeight: FontWeight.bold, color: Color(0xFF0D47A1))),
                    IconButton(
                      icon: const Icon(Icons.close),
                      onPressed: () => Navigator.pop(sheetCtx),
                    ),
                  ],
                ),
                const SizedBox(height: 10),
                TextField(
                  controller: searchCtrl,
                  decoration: InputDecoration(
                    hintText: 'Rechercher un pays ou un code (+224, +225, +33...)',
                    hintStyle: const TextStyle(fontSize: 12),
                    prefixIcon: const Icon(Icons.search),
                    border: OutlineInputBorder(borderRadius: BorderRadius.circular(12)),
                    contentPadding: const EdgeInsets.symmetric(horizontal: 14, vertical: 10),
                  ),
                  onChanged: (val) {
                    setModalState(() {
                      String q = val.toLowerCase().trim();
                      if (q.isEmpty) {
                        filteredList = List.from(allWorldCountryCodes);
                      } else {
                        filteredList = allWorldCountryCodes.where((c) {
                          return c.name.toLowerCase().contains(q) || c.code.contains(q);
                        }).toList();
                      }
                    });
                  },
                ),
                const SizedBox(height: 12),
                Text('${filteredList.length} pays disponibles', style: TextStyle(fontSize: 11, color: Colors.grey.shade600, fontWeight: FontWeight.bold)),
                const SizedBox(height: 8),
                Expanded(
                  child: filteredList.isEmpty
                      ? const Center(child: Text('Aucun pays trouvé.', style: TextStyle(color: Colors.grey)))
                      : ListView.separated(
                          itemCount: filteredList.length,
                          separatorBuilder: (context, index) => const Divider(height: 1),
                          itemBuilder: (itemCtx, index) {
                            final country = filteredList[index];
                            return ListTile(
                              leading: Text(country.flag, style: const TextStyle(fontSize: 24)),
                              title: Text(country.name, style: const TextStyle(fontSize: 14, fontWeight: FontWeight.bold)),
                              trailing: Container(
                                padding: const EdgeInsets.symmetric(horizontal: 10, vertical: 4),
                                decoration: BoxDecoration(color: Colors.blue.shade50, borderRadius: BorderRadius.circular(8)),
                                child: Text(country.code, style: const TextStyle(fontSize: 13, fontWeight: FontWeight.bold, color: Color(0xFF0D47A1))),
                              ),
                              onTap: () {
                                Navigator.pop(sheetCtx);
                                onSelect(country);
                              },
                            );
                          },
                        ),
                ),
              ],
            ),
          );
        },
      );
    },
  );
}


