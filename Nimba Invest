class CorporateLogoPainter extends CustomPainter {
  final String sigle;
  final Color logoColor;
  CorporateLogoPainter({required this.sigle, this.logoColor = const Color(0xFF0D47A1)});

  @override
  void paint(Canvas canvas, Size size) {
    double w = size.width;
    double h = size.height;
    Rect rect = Rect.fromLTWH(0, 0, w, h);

    String s = sigle.toUpperCase();

    // 1. ORANGE GROUP (ORAC, OGUI, SNTS)
    if (s == 'ORAC' || s == 'OGUI' || s == 'SNTS') {
      Paint orangeBg = Paint()..color = const Color(0xFFFF6600);
      canvas.drawRRect(RRect.fromRectAndRadius(rect, Radius.circular(w * 0.25)), orangeBg);
      Paint whiteSquare = Paint()..color = Colors.white;
      canvas.drawRect(Rect.fromLTWH(w * 0.52, h * 0.52, w * 0.36, h * 0.36), whiteSquare);
      return;
    }

    // 2. SOCIÉTÉ GÉNÉRALE (SGBC)
    if (s == 'SGBC') {
      Paint redPaint = Paint()..color = const Color(0xFFE2001A);
      canvas.drawRect(Rect.fromLTWH(0, 0, w, h * 0.48), redPaint);
      Paint blackPaint = Paint()..color = Colors.black;
      canvas.drawRect(Rect.fromLTWH(0, h * 0.52, w, h * 0.48), blackPaint);
      Paint whiteLine = Paint()..color = Colors.white;
      canvas.drawRect(Rect.fromLTWH(0, h * 0.44, w, h * 0.12), whiteLine);
      return;
    }

    // 3. TOTALENERGIES (TTLC, TTLS)
    if (s == 'TTLC' || s == 'TTLS') {
      Paint redP = Paint()..color = const Color(0xFFED1C24);
      Paint blueP = Paint()..color = const Color(0xFF0055A5);
      canvas.drawCircle(Offset(w * 0.35, h * 0.35), w * 0.28, redP);
      canvas.drawCircle(Offset(w * 0.65, h * 0.65), w * 0.28, blueP);
      return;
    }

    // 4. CFAO MOTORS (CFAC)
    if (s == 'CFAC') {
      Paint redBg = Paint()..color = const Color(0xFFC62828);
      canvas.drawRRect(RRect.fromRectAndRadius(rect, Radius.circular(w * 0.2)), redBg);
      Paint silverP = Paint()..color = Colors.white..strokeWidth = 3..style = PaintingStyle.stroke;
      Path p = Path();
      p.moveTo(w * 0.2, h * 0.35);
      p.lineTo(w * 0.5, h * 0.7);
      p.lineTo(w * 0.8, h * 0.35);
      canvas.drawPath(p, silverP);
      return;
    }

    // 5. ECOBANK (ETI)
    if (s == 'ETI') {
      Paint blueBg = Paint()..color = const Color(0xFF003399);
      canvas.drawRRect(RRect.fromRectAndRadius(rect, Radius.circular(w * 0.2)), blueBg);
      Paint cyanArc = Paint()..color = const Color(0xFF00A3E0)..strokeWidth = 3..style = PaintingStyle.stroke;
      canvas.drawArc(Rect.fromLTWH(w*0.15, h*0.2, w*0.7, h*0.6), 0.2, 2.5, false, cyanArc);
      return;
    }

    // 6. SOBRAGUI (SOBR)
    if (s == 'SOBR') {
      Paint redBg = Paint()..color = const Color(0xFFC8102E);
      canvas.drawCircle(Offset(w/2, h/2), w/2, redBg);
      Paint goldP = Paint()..color = Colors.amber..style = PaintingStyle.fill;
      Path crown = Path();
      crown.moveTo(w*0.25, h*0.65);
      crown.lineTo(w*0.2, h*0.35);
      crown.lineTo(w*0.4, h*0.5);
      crown.lineTo(w*0.5, h*0.3);
      crown.lineTo(w*0.6, h*0.5);
      crown.lineTo(w*0.8, h*0.35);
      crown.lineTo(w*0.75, h*0.65);
      crown.close();
      canvas.drawPath(crown, goldP);
      return;
    }

    // 7. SOGUIPAH (SOGU)
    if (s == 'SOGU') {
      Paint greenBg = Paint()..color = const Color(0xFF008751);
      canvas.drawCircle(Offset(w/2, h/2), w/2, greenBg);
      Paint yellowP = Paint()..color = Colors.amber..strokeWidth = 2.5..style = PaintingStyle.stroke;
      canvas.drawLine(Offset(w*0.5, h*0.75), Offset(w*0.5, h*0.3), yellowP);
      canvas.drawLine(Offset(w*0.5, h*0.45), Offset(w*0.25, h*0.35), yellowP);
      canvas.drawLine(Offset(w*0.5, h*0.45), Offset(w*0.75, h*0.35), yellowP);
      return;
    }

    // Default Fallback Logo (Brand Color + Sigle Text)
    Paint defaultBg = Paint()..color = logoColor;
    canvas.drawCircle(Offset(w/2, h/2), w/2, defaultBg);

    TextPainter textPainter = TextPainter(
      text: TextSpan(
        text: sigle,
        style: TextStyle(
          color: Colors.white,
          fontWeight: FontWeight.w900,
          fontSize: w * 0.35,
          letterSpacing: 0.5,
        ),
      ),
      textDirection: TextDirection.ltr,
    );
    textPainter.layout();
    textPainter.paint(
      canvas,
      Offset(w / 2 - textPainter.width / 2, h / 2 - textPainter.height / 2),
    );
  }

  @override
  bool shouldRepaint(covariant CustomPainter oldDelegate) => false;
}

Widget _buildCompanyLogoAvatar(Map<String, dynamic> item, {double radius = 20}) {
  // Logo officiel déposé dans assets/logos/SIGLE.png (prioritaire), sinon réseau, sinon badge.
  final String sg = (item['sigle'] ?? '').toString().trim();
  final Widget secours = _buildCompanyLogoAvatarReseau(item, radius: radius);
  if (sg.isEmpty || !utiliserLogosFichiers) return secours;
  return SizedBox(
    width: radius * 2,
    height: radius * 2,
    child: ClipOval(
      child: Image.asset(
        'assets/logos/$sg.png',
        width: radius * 2,
        height: radius * 2,
        fit: BoxFit.contain,
        errorBuilder: (c, e, st) => secours,
      ),
    ),
  );
}

Widget _buildCompanyLogoAvatarReseau(Map<String, dynamic> item, {double radius = 20}) {
  String sigle = item['sigle'] ?? (item['nom'] != null && item['nom'].toString().length >= 3 ? item['nom'].toString().substring(0, 3).toUpperCase() : 'NMB');
  int colorVal = item['logoColor'] ?? 0xFF0D47A1;
  Color bg = Color(colorVal);
  String? logoUrl = item['logoUrl'];

  Widget fallbackBadge = Container(
    width: radius * 2,
    height: radius * 2,
    decoration: BoxDecoration(
      color: Colors.white,
      shape: BoxShape.circle,
      border: Border.all(color: Colors.grey.shade300, width: 1.2),
      boxShadow: [
        BoxShadow(
          color: Colors.black.withOpacity(0.08),
          blurRadius: 4,
          offset: const Offset(0, 2),
        ),
      ],
    ),
    child: ClipOval(
      child: CustomPaint(
        size: Size(radius * 2, radius * 2),
        painter: CorporateLogoPainter(sigle: sigle, logoColor: bg),
      ),
    ),
  );

  if (logoUrl != null && logoUrl.isNotEmpty) {
    return Container(
      width: radius * 2,
      height: radius * 2,
      decoration: BoxDecoration(
        color: Colors.white,
        shape: BoxShape.circle,
        border: Border.all(color: Colors.grey.shade300, width: 1.2),
        boxShadow: [
          BoxShadow(
            color: Colors.black.withOpacity(0.08),
            blurRadius: 4,
            offset: const Offset(0, 2),
          ),
        ],
      ),
      child: ClipOval(
        child: Image.network(
          logoUrl,
          width: radius * 2,
          height: radius * 2,
          fit: BoxFit.cover,
          errorBuilder: (context, error, stackTrace) => fallbackBadge,
          loadingBuilder: (context, child, loadingProgress) {
            if (loadingProgress == null) return child;
            return fallbackBadge;
          },
        ),
      ),
    );
  }

  return fallbackBadge;
}


