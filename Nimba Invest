// LOGO NIMBA VECTORIEL
class NimbaLogoPainter extends CustomPainter {
  @override
  void paint(Canvas canvas, Size size) {
    Paint bgPaint = Paint()..color = Colors.white;
    canvas.drawCircle(
      Offset(size.width / 2, size.height / 2),
      size.width / 2,
      bgPaint,
    );

    Paint mountainPaint = Paint()
      ..color = const Color(0xFF0F5132)
      ..style = PaintingStyle.fill;

    Path mountainPath = Path();
    mountainPath.moveTo(size.width * 0.2, size.height * 0.75);
    mountainPath.lineTo(size.width * 0.5, size.height * 0.25);
    mountainPath.lineTo(size.width * 0.8, size.height * 0.75);
    mountainPath.close();

    canvas.drawPath(mountainPath, mountainPaint);
  }

  @override
  bool shouldRepaint(covariant CustomPainter oldDelegate) => false;
}

