DateTime _dernierDimancheUtc(int annee, int mois) {
  DateTime d = DateTime.utc(annee, mois + 1, 0);
  while (d.weekday != DateTime.sunday) {
    d = d.subtract(const Duration(days: 1));
  }
  return d;
}

DateTime _nieDimancheUtc(int annee, int mois, int n) {
  DateTime d = DateTime.utc(annee, mois, 1);
  int c = 0;
  while (true) {
    if (d.weekday == DateTime.sunday) {
      c++;
      if (c == n) return d;
    }
    d = d.add(const Duration(days: 1));
  }
}

/// Heure d'été européenne : dernier dimanche de mars (01h UTC) au dernier dimanche d'octobre (01h UTC).
bool _heureEteEurope(DateTime u) {
  final debut = _dernierDimancheUtc(u.year, 3).add(const Duration(hours: 1));
  final fin = _dernierDimancheUtc(u.year, 10).add(const Duration(hours: 1));
  return !u.isBefore(debut) && u.isBefore(fin);
}

/// Heure d'été américaine : 2e dimanche de mars (07h UTC) au 1er dimanche de novembre (06h UTC).
bool _heureEteUS(DateTime u) {
  final debut = _nieDimancheUtc(u.year, 3, 2).add(const Duration(hours: 7));
  final fin = _nieDimancheUtc(u.year, 11, 1).add(const Duration(hours: 6));
  return !u.isBefore(debut) && u.isBefore(fin);
}

/// Codes : BRVM (et Guinée), NGX, EURONEXT (CAC 40), US (NYSE / Nasdaq). Lundi au vendredi.
/// Les jours fériés boursiers ne sont pas pris en compte. À vérifier auprès de chaque bourse.
bool bourseOuverte(String? bourse) {
  if (forcerMarcheOuvertDemo) return true;
  final now = DateTime.now().toUtc();
  if (now.weekday > DateTime.friday) return false;
  final int min = now.hour * 60 + now.minute;
  switch (bourse) {
    case 'NGX':
      return min >= 540 && min < 810; // 10h00-14h30 heure du Nigeria (UTC+1)
    case 'EURONEXT':
      final int dp = _heureEteEurope(now) ? 120 : 60;
      return min >= 540 - dp && min < 1050 - dp; // 09h00-17h30 heure de Paris
    case 'US':
      final int dn = _heureEteUS(now) ? 240 : 300;
      return min >= 570 + dn && min < 960 + dn; // 09h30-16h00 heure de New York
    default:
      return min >= 540 && min < 930; // BRVM / Guinée : 09h00-15h30 GMT
  }
}

