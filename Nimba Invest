// 🎨 EMBLEM / LOGO BRVM & FRANC CFA (UEMOA)
// ============================================================
class FcfaUemoaLogoPainter extends CustomPainter {
  @override
  void paint(Canvas canvas, Size size) {
    Paint bgCircle = Paint()..color = const Color(0xFF0F5132);
    canvas.drawCircle(Offset(size.width / 2, size.height / 2), size.width / 2, bgCircle);

    Paint ringPaint = Paint()
      ..color = Colors.amber.shade600
      ..style = PaintingStyle.stroke
      ..strokeWidth = 2.5;
    canvas.drawCircle(Offset(size.width / 2, size.height / 2), size.width / 2 - 3, ringPaint);

    TextPainter textPainter = TextPainter(
      text: const TextSpan(
        text: 'CFA',
        style: TextStyle(
          color: Colors.amber,
          fontWeight: FontWeight.bold,
          fontSize: 11,
          letterSpacing: 1.0,
        ),
      ),
      textDirection: TextDirection.ltr,
    );
    textPainter.layout();
    textPainter.paint(
      canvas,
      Offset(size.width / 2 - textPainter.width / 2, size.height / 2 - textPainter.height / 2),
    );
  }

  @override
  bool shouldRepaint(covariant CustomPainter oldDelegate) => false;
}



